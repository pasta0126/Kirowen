                "exec": [
                  "pm.test(\"4xx\", () => pm.expect(pm.response.code).to.be.within(400, 499));"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit a non-envelope (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/v0/events",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "not cbor"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"4xx\", () => pm.expect(pm.response.code).to.be.within(400, 499));"
                ]
