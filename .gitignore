# local registry, witness or monitor.
/data/
/tmp/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log

# --- Secrets and keys ---
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.sec
*.secret
secrets/

# --- Editors and IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Agent local files (personal, not shared) ---
.claude/settings.local.json
CLAUDE.local.md
