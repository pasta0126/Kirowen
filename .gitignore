# --- Go ---
# Binaries
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Coverage and profiling
coverage.*
*.coverprofile
*.prof
*.pprof

# Workspace files (local only)
go.work
go.work.sum

# Vendored dependencies (we use modules)
/vendor/

# --- Local registry data (never commit log contents) ---
